APP_IDENTIFIER = "com.jdarkyeka6.tidesearch"

default_platform(:ios)

platform :ios do
  desc "Build TideSearch and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip
    raw_key   = ENV["ASC_KEY_CONTENT"].to_s.strip

    missing = []
    missing << "ASC_KEY_ID" if key_id.empty?
    missing << "ASC_ISSUER_ID" if issuer_id.empty?
    missing << "APPLE_TEAM_ID" if team_id.empty?
    missing << "ASC_KEY_CONTENT" if raw_key.empty?
    UI.user_error!("Missing GitHub secret(s): #{missing.join(', ')}") unless missing.empty?

    require "base64"
    require "openssl"
    require "shellwords"

    # Accept raw PEM, quoted PEM, PEM with literal \\n sequences, full-PEM base64,
    # DER base64, or only the base64 body from inside an AuthKey_*.p8 file.
    normalized = raw_key.dup
    if normalized.length >= 2 && ((normalized.start_with?("\"") && normalized.end_with?("\"")) || (normalized.start_with?("'") && normalized.end_with?("'")))
      normalized = normalized[1...-1]
    end
    normalized = normalized.gsub("\\r\\n", "\n").gsub("\\n", "\n").gsub("\r\n", "\n").strip

    key_text = normalized

    unless key_text.include?("-----BEGIN PRIVATE KEY-----")
      compact = normalized.gsub(/\s+/, "")

      begin
        decoded = Base64.strict_decode64(compact)
        decoded_text = decoded.dup.force_encoding("UTF-8")

        if decoded_text.valid_encoding? && decoded_text.include?("-----BEGIN PRIVATE KEY-----")
          key_text = decoded_text.gsub("\r\n", "\n")
        elsif !decoded.empty? && decoded.getbyte(0) == 0x30
          body = Base64.strict_encode64(decoded).scan(/.{1,64}/).join("\n")
          key_text = "-----BEGIN PRIVATE KEY-----\n#{body}\n-----END PRIVATE KEY-----\n"
        end
      rescue ArgumentError
        # Not full-value base64. It may simply be the body of the PEM.
      end

      if !key_text.include?("-----BEGIN PRIVATE KEY-----") && compact.match?(/\A[A-Za-z0-9+\/=]+\z/) && compact.length >= 100
        body = compact.scan(/.{1,64}/).join("\n")
        key_text = "-----BEGIN PRIVATE KEY-----\n#{body}\n-----END PRIVATE KEY-----\n"
      end
    end

    unless key_text.include?("-----BEGIN PRIVATE KEY-----") && key_text.include?("-----END PRIVATE KEY-----")
      classification = if normalized.match?(/\AAuthKey_[A-Za-z0-9_-]+\.p8\z/i)
        "It looks like the .p8 filename, not the file contents."
      elsif normalized.match?(/\A[A-Z0-9]{8,20}\z/i)
        "It looks like a short Key ID or other identifier, not the private key contents."
      elsif normalized.start_with?("{") || normalized.start_with?("[")
        "It looks like JSON or another structured value, not an Apple .p8 private key."
      elsif normalized.length < 100
        "The stored value is far too short to be an Apple .p8 private key."
      else
        "The stored value is long enough, but it is not valid PEM/base64 private-key data."
      end

      UI.user_error!("ASC_KEY_CONTENT is invalid. #{classification} Open the original AuthKey_*.p8 in a text editor and paste the entire file contents into the GitHub secret.")
    end

    begin
      OpenSSL::PKey.read(key_text)
    rescue OpenSSL::PKey::PKeyError, ArgumentError
      UI.user_error!("ASC_KEY_CONTENT has a private-key-looking format, but the key data itself is invalid. Re-copy the contents from the original AuthKey_*.p8 file.")
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text.end_with?("\n") ? key_text : "#{key_text}\n")
    File.chmod(0600, key_path)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # GitHub-hosted macOS runners are disposable. Creating a fresh Apple Distribution
    # certificate on every run eventually hits Apple's certificate limit because the
    # private key from an older runner cannot be recovered. Use Xcode automatic/cloud
    # signing instead, authenticated with the App Store Connect API key.
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: true,
      team_id: team_id,
      targets: ["App"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )

    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest + 1
    )

    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{Shellwords.escape(key_path)}",
      "-authenticationKeyID #{Shellwords.escape(key_id)}",
      "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}",
      "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
      "CODE_SIGN_STYLE=Automatic"
    ].join(" ")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        signingStyle: "automatic",
        teamID: team_id
      },
      xcargs: auth_args,
      export_xcargs: auth_args
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
