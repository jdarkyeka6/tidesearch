APP_IDENTIFIER = "com.jdarkyeka6.tidesearch"

default_platform(:ios)

platform :ios do
  desc "Build TideSearch and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip
    raw_key   = ENV["ASC_KEY_CONTENT"].to_s.strip

    missing = []
    missing << "ASC_KEY_ID" if key_id.empty?
    missing << "ASC_ISSUER_ID" if issuer_id.empty?
    missing << "APPLE_TEAM_ID" if team_id.empty?
    missing << "ASC_KEY_CONTENT" if raw_key.empty?
    UI.user_error!("Missing GitHub secret(s): #{missing.join(', ')}") unless missing.empty?

    # GitHub secrets are commonly pasted in several equivalent forms.
    # Accept raw PEM, quoted PEM, PEM with literal \\n sequences, or base64.
    normalized = raw_key.dup
    if normalized.length >= 2 && ((normalized.start_with?("\"") && normalized.end_with?("\"")) || (normalized.start_with?("'") && normalized.end_with?("'")))
      normalized = normalized[1...-1]
    end
    normalized = normalized.gsub("\\r\\n", "\n").gsub("\\n", "\n").gsub("\r\n", "\n")

    key_text = normalized

    unless key_text.include?("BEGIN PRIVATE KEY")
      require "base64"
      begin
        compact = normalized.gsub(/\s+/, "")
        decoded = Base64.strict_decode64(compact)
        key_text = decoded.gsub("\r\n", "\n")
      rescue ArgumentError
        # Leave key_text unchanged so the clear validation error below is used.
      end
    end

    unless key_text.include?("-----BEGIN PRIVATE KEY-----") && key_text.include?("-----END PRIVATE KEY-----")
      UI.user_error!("ASC_KEY_CONTENT was received, but it is not an Apple .p8 private key. Paste the complete AuthKey_*.p8 contents, including BEGIN/END PRIVATE KEY lines, or its base64 encoding.")
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text.end_with?("\n") ? key_text : "#{key_text}\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    keychain_name = "tidesearch-ci.keychain"
    keychain_pw = "tidesearch-ci-temp"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    cert(
      api_key: api_key,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    )

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )

    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest + 1
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
